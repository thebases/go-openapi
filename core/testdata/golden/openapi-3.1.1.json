{
  "openapi": "3.1.1",
  "info": {
    "title": "Golden API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.example.com",
      "description": "Production"
    }
  ],
  "paths": {
    "/merchants/{id}": {
      "get": {
        "tags": [
          "merchants"
        ],
        "operationId": "getMerchant",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Merchant",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/goldenMerchant"
                }
              }
            }
          }
        },
        "security": [
          {
            "apiKey": []
          }
        ],
        "x-rate-limit": 100
      }
    }
  },
  "components": {
    "schemas": {
      "goldenAddress": {
        "required": [
          "city"
        ],
        "type": "object",
        "properties": {
          "city": {
            "type": "string",
            "example": "Hanoi"
          }
        }
      },
      "goldenMerchant": {
        "required": [
          "id",
          "name",
          "status",
          "balance"
        ],
        "type": "object",
        "properties": {
          "address": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/goldenAddress"
              },
              {
                "type": "null"
              }
            ]
          },
          "attributes": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "format": "int64"
            }
          },
          "balance": {
            "minimum": 0,
            "type": "number",
            "format": "double"
          },
          "id": {
            "type": "integer",
            "format": "int64",
            "readOnly": true,
            "example": 42
          },
          "name": {
            "maxLength": 64,
            "minLength": 1,
            "type": "string"
          },
          "parentId": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "enum": [
              "active",
              "suspended"
            ],
            "type": "string",
            "default": "active"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "securitySchemes": {
      "apiKey": {
        "type": "apiKey",
        "name": "X-API-Key",
        "in": "header"
      }
    }
  }
}