{
  "components": {
    "schemas": {
      "goldenAddress": {
        "properties": {
          "city": {
            "example": "Hanoi",
            "type": "string"
          }
        },
        "required": [
          "city"
        ],
        "type": "object"
      },
      "goldenMerchant": {
        "properties": {
          "address": {
            "allOf": [
              {
                "$ref": "#/components/schemas/goldenAddress"
              }
            ],
            "nullable": true
          },
          "attributes": {
            "additionalProperties": {
              "format": "int64",
              "type": "integer"
            },
            "type": "object"
          },
          "balance": {
            "format": "double",
            "minimum": 0,
            "type": "number"
          },
          "id": {
            "example": 42,
            "format": "int64",
            "readOnly": true,
            "type": "integer"
          },
          "name": {
            "maxLength": 64,
            "minLength": 1,
            "type": "string"
          },
          "parentId": {
            "nullable": true,
            "type": "string"
          },
          "status": {
            "default": "active",
            "enum": [
              "active",
              "suspended"
            ],
            "type": "string"
          },
          "tags": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "id",
          "name",
          "status",
          "balance"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "apiKey": {
        "in": "header",
        "name": "X-API-Key",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "title": "Golden API",
    "version": "1.0.0"
  },
  "openapi": "3.0.4",
  "paths": {
    "/merchants/{id}": {
      "get": {
        "operationId": "getMerchant",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/goldenMerchant"
                }
              }
            },
            "description": "Merchant"
          }
        },
        "security": [
          {
            "apiKey": []
          }
        ],
        "tags": [
          "merchants"
        ],
        "x-rate-limit": 100
      }
    }
  },
  "servers": [
    {
      "description": "Production",
      "url": "https://api.example.com"
    }
  ]
}